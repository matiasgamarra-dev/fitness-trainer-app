{
  "name": "@fitness-trainer/web",
  "version": "0.1.0",
  "description": "Frontend web de Fitness Trainer App (React + Vite + TypeScript)",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
