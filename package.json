{
  "name": "fitness-trainer-app",
  "version": "0.1.0",
  "description": "Aplicación de seguimiento personal que integra nutrición, entrenamiento y progreso físico.",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "echo \"Próximamente: script dev del monorepo\" && exit 0",
    "build": "echo \"Próximamente: script build del monorepo\" && exit 0",
    "test": "echo \"Sin tests aún\" && exit 0",
    "lint": "eslint . --no-error-on-unmatched-pattern",
    "lint:fix": "eslint . --fix --no-error-on-unmatched-pattern",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docs:changelog": "node scripts/docs-changelog.js",
    "docs:roadmap": "node scripts/docs-roadmap.js",
    "docs:context": "node scripts/docs-context.js",
    "docs:check": "node scripts/docs-check.js",
    "docs:sync": "node scripts/docs-sync.js"
  },
  "keywords": [
    "fitness",
    "workout",
    "training",
    "health",
    "pwa"
  ],
  "author": "Matías Gamarra",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/matiasgamarra-dev/fitness-trainer-app.git"
  },
  "bugs": {
    "url": "https://github.com/matiasgamarra-dev/fitness-trainer-app/issues"
  },
  "homepage": "https://github.com/matiasgamarra-dev/fitness-trainer-app#readme",
  "engines": {
    "node": ">=20",
    "npm": ">=10"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.3",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1"
  }
}
